# -----------------------------------------------------------------------------
# Enterprise Automation Environment Configuration Template
# Copy this file to .env.qa, .env.staging, or .env.uat as needed.
# NEVER commit production credentials or sensitive tokens to version control.
# -----------------------------------------------------------------------------

ENV=UAT
BASE_URL=https://smeclouat.hdfcbank.com
API_BASE_URL=https://smeclouat.hdfcbank.com/api/v1

# Authentication & Credentials
RM_USER_ID=A10773
RM_PASSWORD=SamplePassword123!
DEFAULT_OTP=123456

# Business Classification
BUSINESS_GROUP=Working Capital
BUSINESS_SEGMENT=BBG

# Execution Flags
HEADLESS=true
BROWSER=chromium
WORKERS=4
RETRIES=1
TIMEOUT_MS=60000

# Reporting & Tracing
ENABLE_ALLURE=true
ENABLE_TRACE=on
ENABLE_VIDEO=retain-on-failure
ENABLE_SCREENSHOT=only-on-failure
