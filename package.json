{
  "name": "mvp1",
  "version": "1.0.0",
  "type": "module",
  "description": "HDFC Xpress BizFinance — Playwright E2E Tests",
  "main": "index.js",
  "scripts": {
    "test":             "node --env-file .env.uat node_modules/.bin/playwright test",
    "test:uat":         "node --env-file .env.uat node_modules/.bin/playwright test",
    "test:sit":         "node --env-file .env.sit node_modules/.bin/playwright test",
    "test:headless":    "node --env-file .env.uat node_modules/.bin/playwright test --env HEADLESS=true",
    "test:login":       "node --env-file .env.uat node_modules/.bin/playwright test tests/login.spec.js",
    "test:modules":     "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/",
    "test:journey":     "node --env-file .env.uat node_modules/.bin/playwright test tests/journey.spec.js",
    "test:ci":          "node --env-file .env.uat node_modules/.bin/playwright test --reporter=html,github",
    "test:module:dash":       "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/dashboard.spec.js",
    "test:module:lead":       "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/createLead.spec.js",
    "test:module:profile":    "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/customerProfile.spec.js",
    "test:module:product":    "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/product.spec.js",
    "test:module:financials": "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/financials.spec.js",
    "test:module:sourcing":   "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/sourcing.spec.js",
    "report":           "npx playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "dotenv": "^17.3.1"
  }
}