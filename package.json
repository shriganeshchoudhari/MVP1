{
  "name": "mvp1",
  "version": "1.0.0",
  "type": "module",
  "description": "HDFC Xpress BizFinance — Enterprise Playwright Automation Ecosystem",
  "main": "index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test:framework": "playwright test --config config/playwright.config.ts",
    "test:smoke": "playwright test tests/smoke --config config/playwright.config.ts",
    "test:ui": "playwright test tests/ui --config config/playwright.config.ts",
    "test:api": "playwright test tests/api --config config/playwright.config.ts",
    "test:a11y": "playwright test tests/accessibility --config config/playwright.config.ts",
    "test:visual": "playwright test tests/visual --config config/playwright.config.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test": "node --env-file .env.uat node_modules/.bin/playwright test",
    "test:uat": "node --env-file .env.uat node_modules/.bin/playwright test",
    "test:sit": "node --env-file .env.sit node_modules/.bin/playwright test",
    "test:headless": "node --env-file .env.uat node_modules/.bin/playwright test --env HEADLESS=true",
    "test:login": "node --env-file .env.uat node_modules/.bin/playwright test login.spec.js",
    "test:modules": "node --env-file .env.uat node_modules/.bin/playwright test tests/modules/",
    "test:journey": "node --env-file .env.uat node_modules/.bin/playwright test tests/journey.spec.js",
    "test:ci": "node --env-file .env.uat node_modules/.bin/playwright test --reporter=html,github",
    "report": "npx playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "enterprise",
    "banking"
  ],
  "author": "Principal Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "allure-playwright": "^3.14.0",
    "dotenv": "^17.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
